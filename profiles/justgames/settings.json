{
  "$comment": "Template rendered by `agentfiles bootstrap justgames` into ~/.claude-justgames/settings.json. ${AGENTFILES} is substituted.",
  "extraKnownMarketplaces": {
    "agentfiles": { "source": { "source": "directory", "path": "${AGENTFILES}" } }
  },
  "fallbackSources": {
    "agentfiles": { "source": "github", "repo": "robinbryce/agentfiles" }
  },
  "enabledPlugins": {
    "core@agentfiles": true,
    "justgames@agentfiles": true
  },
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": { "options": { "instructionFiles": "claude-md-and-agents-md" } }
  },
  "alwaysThinkingEnabled": true
}
