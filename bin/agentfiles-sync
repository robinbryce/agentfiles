#!/usr/bin/env bash
# agentfiles-sync — install agentfiles skills as slash commands for every
# harness that reads the Agent Skills layout.
#
# One canonical skill directory (<src>/<name>/SKILL.md) is symlinked into each
# harness's discovery path. Nothing is copied, so there is no drift: edit the
# skill in agentfiles and every harness sees the change immediately.
#
#   Claude Code   .claude/skills/<name>       ~/.claude/skills/<name>
#   Cursor        .cursor/skills/<name>       ~/.cursor/skills/<name>
#                 (also reads .claude/skills — installed anyway for belt & braces)
#   pi / generic  .agents/skills/<name>       ~/.agents/skills/<name>
#   Cursor legacy .cursor/commands/<name>.md  -> the skill's SKILL.md
#
# Layering: sources are applied lowest-precedence first, so a scope's own skill
# of the same name shadows the cross-scope one — matching the precedence in
# AGENTS.md (repo overlay -> scope -> common workflow).
#
# Usage:
#   agentfiles-sync <scope> [repo-dir]     # per-repo install (default, recommended)
#   agentfiles-sync --global               # cross-scope skills only, machine-wide
#   agentfiles-sync <scope> --dry-run      # show what would change
#   agentfiles-sync <scope> --prune        # also remove managed links no longer in source
#
# Per-repo is the default because Claude Code resolves personal skills ABOVE
# project skills: a machine-wide /save-status would shadow a repo's own. Only
# install globally what is genuinely universal.
set -euo pipefail

AGENTFILES="${AGENTFILES:-$HOME/agentfiles}"
SCOPE=""; REPO=""; GLOBAL=0; DRY=0; PRUNE=0

die() { echo "agentfiles-sync: $*" >&2; exit 1; }
say() { echo "  $*"; }
run() { if [ "$DRY" = 1 ]; then echo "  [dry-run] $*"; else "$@"; fi; }

while [ $# -gt 0 ]; do
  case "$1" in
    --global)  GLOBAL=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --prune)   PRUNE=1; shift ;;
    -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
    -*) die "unknown flag: $1" ;;
    *) if [ -z "$SCOPE" ]; then SCOPE="$1"; else REPO="$1"; fi; shift ;;
  esac
done

[ -d "$AGENTFILES" ] || die "no agentfiles checkout at $AGENTFILES (set AGENTFILES)"

# ---------------------------------------------------------------- sources ---
# Lowest precedence first. A later source with the same skill name wins.
SOURCES=()
add_source() { [ -d "$1" ] && SOURCES+=("$1") || true; }

add_source "$AGENTFILES/workflow/skills"

if [ "$GLOBAL" = 0 ]; then
  [ -n "$SCOPE" ] || die "usage: agentfiles-sync <scope> [repo-dir]  |  agentfiles-sync --global"
  [ -d "$AGENTFILES/scopes/$SCOPE" ] || die "unknown scope '$SCOPE' (no $AGENTFILES/scopes/$SCOPE)"

  # A scope may pull in skills owned by another repo (e.g. the shared
  # forestrie-agents repo) via scopes/<scope>/skills.sources — one path per
  # line, '#' comments, ~ and $VAR expanded, missing paths skipped.
  SRCFILE="$AGENTFILES/scopes/$SCOPE/skills.sources"
  if [ -f "$SRCFILE" ]; then
    while IFS= read -r line; do
      line="${line%%#*}"; line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      [ -n "$line" ] || continue
      expanded="$(eval printf '%s' "\"$line\"")"
      if [ -d "$expanded" ]; then add_source "$expanded"
      else say "skip (not present): $line"; fi
    done < "$SRCFILE"
  fi

  add_source "$AGENTFILES/scopes/$SCOPE/workflow/skills"
fi

[ "${#SOURCES[@]}" -gt 0 ] || die "no skill sources found"

# ---------------------------------------------------------------- targets ---
if [ "$GLOBAL" = 1 ]; then
  ROOT="$HOME"
  SKILL_DIRS=("$HOME/.claude/skills" "$HOME/.cursor/skills" "$HOME/.agents/skills")
  CMD_DIR="$HOME/.cursor/commands"
  LABEL="machine-wide (cross-scope skills only)"
else
  REPO="${REPO:-$PWD}"
  [ -d "$REPO" ] || die "repo dir not found: $REPO"
  if git -C "$REPO" rev-parse --show-toplevel >/dev/null 2>&1; then
    REPO="$(git -C "$REPO" rev-parse --show-toplevel)"
  fi
  ROOT="$REPO"
  SKILL_DIRS=("$REPO/.claude/skills" "$REPO/.cursor/skills" "$REPO/.agents/skills")
  CMD_DIR="$REPO/.cursor/commands"
  LABEL="scope '$SCOPE' in $REPO"
fi

echo "agentfiles-sync: $LABEL"
for s in "${SOURCES[@]}"; do say "source: $s"; done

# ------------------------------------------------------------- resolution ---
# name -> absolute source dir, later sources winning.
declare -A RESOLVED=()
for src in "${SOURCES[@]}"; do
  for d in "$src"/*/; do
    [ -f "$d/SKILL.md" ] || continue
    RESOLVED["$(basename "$d")"]="${d%/}"
  done
done
[ "${#RESOLVED[@]}" -gt 0 ] || die "no <name>/SKILL.md directories under the sources"

# ------------------------------------------------------------------ link ---
# Only ever replace a symlink. A real file or directory is someone else's and
# is left untouched with a warning.
link_one() {
  local target="$1" dest="$2"
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    say "skip $dest (real file/dir — not overwriting)"; return 1
  fi
  run ln -sfn "$target" "$dest"
}

for dir in "${SKILL_DIRS[@]}"; do run mkdir -p "$dir"; done
run mkdir -p "$CMD_DIR"

for name in $(printf '%s\n' "${!RESOLVED[@]}" | sort); do
  target="${RESOLVED[$name]}"
  for dir in "${SKILL_DIRS[@]}"; do link_one "$target" "$dir/$name"; done
  link_one "$target/SKILL.md" "$CMD_DIR/$name.md"
  say "/$name -> $target"
done

# ----------------------------------------------------------------- prune ---
# Remove managed links whose target no longer resolves, or which point into a
# source tree but name a skill that is gone. Never touches non-symlinks.
if [ "$PRUNE" = 1 ]; then
  for dir in "${SKILL_DIRS[@]}"; do
    [ -d "$dir" ] || continue
    for entry in "$dir"/*; do
      [ -L "$entry" ] || continue
      base="$(basename "$entry")"
      if [ -z "${RESOLVED[$base]+x}" ] || [ ! -e "$entry" ]; then
        say "prune $entry"; run rm -f "$entry"
      fi
    done
  done
  for entry in "$CMD_DIR"/*.md; do
    [ -L "$entry" ] || continue
    base="$(basename "$entry" .md)"
    if [ -z "${RESOLVED[$base]+x}" ] || [ ! -e "$entry" ]; then
      say "prune $entry"; run rm -f "$entry"
    fi
  done
fi

# ------------------------------------------------------------ git exclude ---
# Keep the generated links out of git status so they are never committed into
# a repo that does not own them.
if [ "$GLOBAL" = 0 ] && git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
  gitdir="$(git -C "$ROOT" rev-parse --git-dir)"
  case "$gitdir" in /*) ;; *) gitdir="$ROOT/$gitdir" ;; esac
  excl="$gitdir/info/exclude"
  run mkdir -p "$gitdir/info"
  if [ "$DRY" = 0 ]; then
    for p in "/.claude/skills/" "/.cursor/skills/" "/.cursor/commands/" "/.agents/"; do
      grep -qxF "$p" "$excl" 2>/dev/null || echo "$p" >> "$excl"
    done
  fi
  say "excluded generated link dirs via $excl"
fi

echo "done. ${#RESOLVED[@]} skill(s) installed."
